    nav { display:flex; flex-wrap:wrap; gap:18px; font:600 13px Arial,sans-serif; text-transform:uppercase; letter-spacing:.08em; }
    nav a { text-decoration:none; color:var(--muted); }
    nav a:hover, nav a:focus-visible { color:var(--accent-dark); }
    .hero { min-height:78vh; display:grid; place-items:end start; padding:clamp(36px,7vw,92px); background:linear-gradient(90deg,rgba(17,30,30,.72),rgba(17,30,30,.08)),url('img/steve-picks/08/IMG_5346.jpg') center/cover; color:var(--white); }
    .hero-copy { max-width:680px; }
    .eyebrow { font:700 12px Arial,sans-serif; letter-spacing:.16em; text-transform:uppercase; color:var(--accent-dark); }
    .hero .eyebrow, .portfolio .eyebrow { color:#ecd5be; }
    h1,h2,h3 { line-height:1.1; margin:0 0 18px; }
    h1 { font-size:clamp(42px,7vw,88px); max-width:760px; }
    h2 { font-size:clamp(32px,4vw,56px); }
    h3 { font-size:24px; }
    .hero p { max-width:590px; font-size:clamp(18px,2vw,24px); }
    .button { display:inline-block; padding:12px 18px; border:1px solid var(--accent); background:var(--accent); color:white; text-decoration:none; font:700 13px Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .button.secondary { background:transparent; border-color:rgba(255,255,255,.7); margin-left:8px; }
    section { padding:clamp(56px,8vw,112px) clamp(20px,6vw,88px); }
    .section-intro { max-width:740px; margin-bottom:34px; }
    .section-intro p { color:var(--muted); font-size:19px; }
    .story-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
    .story-card { padding:26px; background:var(--white); border:1px solid var(--line); }
    .story-card p { color:var(--muted); margin-bottom:0; }
    .portfolio { background:var(--dark); color:var(--white); }
    .portfolio .section-intro p { color:#cbd6d2; }
    .filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:24px; }
    .filters button { border:1px solid #627777; border-radius:999px; padding:9px 14px; background:transparent; color:white; font:700 12px Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .filters button[aria-pressed="true"], .filters button:hover, .filters button:focus-visible { background:var(--accent); border-color:var(--accent); }
    .gallery { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .project-card { margin:0; background:#314344; overflow:hidden; }
    .project-card img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; }
    .project-card figcaption { padding:13px 15px 16px; }
    .project-card strong { display:block; font:700 16px Arial,sans-serif; }
    .project-card span { color:#cbd6d2; font-size:14px; }
    .process { background:#eeeae0; }
    .dark-process { background:var(--dark); color:var(--white); }
    .dark-process .eyebrow { color:#ecd5be; }
    .dark-process .section-intro p { color:#cbd6d2; }
    .dark-process .step { background:#314344; }
    .dark-process .step p { color:#cbd6d2; }
    .dark-process .step b, .dark-process .step i { color:#ecd5be; }
    .process-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; }
    .step { padding:22px 16px; border-top:3px solid var(--accent); background:rgba(255,255,255,.55); }
    .step i { display:block; margin-bottom:18px; color:var(--accent-dark); font-size:36px; }
