<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Custom kitchens, bathrooms, and millwork from Artisan Kitchen and Bath in Cornwall and Prescott, Ontario.">
  <title>Artisan Kitchen and Bath | Custom Kitchens, Baths & Millwork</title>
  <style>
    :root { --ink:#1c2a2b; --muted:#465556; --paper:#f7f6f1; --white:#fff; --line:#d9dfdb; --accent:#a06a43; --accent-dark:#70452b; --dark:#243536; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; background:var(--paper); color:var(--ink); font:16px/1.6 Georgia,serif; }
    a { color:inherit; }
    .site-header { position:sticky; top:0; z-index:5; display:flex; justify-content:space-between; align-items:center; gap:24px; padding:16px clamp(20px,5vw,72px); background:rgba(247,246,241,.96); border-bottom:1px solid var(--line); backdrop-filter:blur(10px); }
    .brand { display:flex; align-items:center; gap:10px; text-decoration:none; font:700 19px/1.1 Arial,sans-serif; letter-spacing:.03em; text-transform:uppercase; }
    .brand img { width:148px; height:auto; }
    nav { display:flex; flex-wrap:wrap; gap:18px; font:600 13px Arial,sans-serif; text-transform:uppercase; letter-spacing:.08em; }
    nav a { text-decoration:none; color:var(--muted); }
    nav a:hover, nav a:focus-visible { color:var(--accent-dark); outline:3px solid #f4c49c; outline-offset:4px; }
    nav a.active { color:var(--accent-dark); border-bottom:2px solid var(--accent-dark); padding-bottom:4px; }
    .button:hover, .button:focus-visible { background:#58351f; border-color:#58351f; color:#fff; }
    .hero { min-height:78vh; display:grid; place-items:end start; padding:clamp(36px,7vw,92px); background:linear-gradient(90deg,rgba(17,30,30,.88) 0%,rgba(17,30,30,.68) 48%,rgba(17,30,30,.2) 100%),url('img/steve-picks/08/IMG_5346.jpg') center/cover; color:var(--white); }
    .hero-copy { max-width:680px; padding:28px; background:rgba(17,30,30,.28); }
    .eyebrow { font:700 12px Arial,sans-serif; letter-spacing:.16em; text-transform:uppercase; color:var(--accent-dark); }
    .hero .eyebrow, .portfolio .eyebrow { color:#ecd5be; }
    h1,h2,h3 { line-height:1.1; margin:0 0 18px; }
    h1 { font-size:clamp(42px,7vw,88px); max-width:760px; }
    h2 { font-size:clamp(32px,4vw,56px); }
    h3 { font-size:24px; }
    .hero p { max-width:590px; font-size:clamp(18px,2vw,24px); }
    .button { display:inline-block; padding:12px 18px; border:1px solid var(--accent-dark); background:var(--accent-dark); color:white; text-decoration:none; font:700 13px Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .button.secondary { background:transparent; border-color:rgba(255,255,255,.7); margin-left:8px; }
    section { padding:clamp(56px,8vw,112px) clamp(20px,6vw,88px); }
    .section-intro { max-width:740px; margin-bottom:34px; }
    .section-intro p { color:var(--muted); font-size:19px; }
    .story-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
    .story-card { padding:26px; background:var(--white); border:1px solid var(--line); }
    .story-card p { color:var(--muted); margin-bottom:0; }
    .portfolio { background:#202428; color:var(--white); }
    .portfolio .section-intro p { color:#cbd6d2; }
    .filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:24px; }
    .filters button { border:1px solid #627777; border-radius:999px; padding:9px 14px; background:transparent; color:white; font:700 12px Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .filters button[aria-pressed="true"], .filters button:hover, .filters button:focus-visible { background:var(--accent-dark); border-color:var(--accent-dark); color:#fff; }
    .gallery { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .project-card { margin:0; background:#314344; overflow:hidden; }
    .project-card img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; }
    .project-card figcaption { padding:13px 15px 16px; }
    .project-card strong { display:block; font:700 16px Arial,sans-serif; }
    .project-card span { color:#cbd6d2; font-size:14px; }
    .process { background:#eeeae0; }
    .dark-process { background:var(--paper); color:var(--ink); }
    .dark-process .eyebrow { color:var(--accent-dark); }
    .dark-process .section-intro p { color:var(--muted); }
    .dark-process .step { background:rgba(255,255,255,.55); }
    .dark-process .step p { color:var(--muted); }
    .dark-process .step b, .dark-process .step i { color:var(--accent-dark); }
    .dealers { background:#202428; color:var(--white); }
    .dealers .eyebrow, .testimonials .eyebrow { color:#f4c49c; }
    .dealers h2 { text-align:left; }
    .dealers .section-intro p { color:#cbd6d2; }
    .dealer-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:0 0 34px; }
    .dealer-logo { display:flex; align-items:center; justify-content:center; min-height:130px; padding:22px 16px; border-top:3px solid var(--accent); background:#314344; }
    .dealer-logo:hover, .dealer-logo:focus-visible { background:#3b5051; outline:3px solid #f4c49c; outline-offset:4px; }
    .dealer-logo img { display:block; max-height:76px; width:auto; max-width:100%; }
    .dealers-link { display:inline-block; width:auto; padding:12px 18px; background:var(--accent-dark); color:#fff; font:700 13px/1.2 Arial,sans-serif; letter-spacing:.08em; text-decoration:none; text-transform:uppercase; }
    .dealers-link:hover, .dealers-link:focus-visible { background:#58351f; color:#fff; outline:3px solid #f4c49c; outline-offset:4px; }
    .testimonials { background:var(--dark); color:var(--white); }
    .testimonials .section-intro p { color:#cbd6d2; }
    .testimonial-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px 34px; }
    .testimonial { position:relative; margin:0; padding:52px 34px 24px; border-top:3px solid var(--accent); background:#314344; }
    .testimonial::before { content:'“'; position:absolute; top:8px; left:14px; color:#ecd5be; font:700 58px/1 Georgia,serif; }
    .testimonial p { margin:0 0 16px; color:#e5ece8; }
    .testimonial p:last-of-type { margin-bottom:12px; }
    .testimonial footer { padding:0; background:transparent; color:#ecd5be; font:700 13px Arial,sans-serif; letter-spacing:.03em; }
    .testimonial cite { font-style:normal; }
    .testimonial-rating { margin-left:8px; color:#f6d447; letter-spacing:.08em; }
    .process-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; }
    .step { padding:22px 16px; border-top:3px solid var(--accent); background:rgba(255,255,255,.55); }
    .step i { display:block; margin-bottom:18px; color:var(--accent-dark); font-size:36px; }
    .step b { display:block; color:var(--accent-dark); font:700 12px Arial,sans-serif; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; }
    .step p { margin:0; color:var(--muted); }
    .about-grid, .contact-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:50px; align-items:start; }
    .contact-card { padding:28px; background:white; border:1px solid var(--line); }
    .contact-card p { margin:8px 0; }
    .contact-card a { color:var(--accent-dark); }
    .contact-card a { display:inline-block; padding:1px 3px; margin:-1px -3px; }
    .contact-card a:hover, .contact-card a:focus { outline:3px solid #f4c49c; outline-offset:4px; }
    footer { padding:36px clamp(20px,6vw,88px); background:#182526; color:#d7e0dc; }
    footer .footer-grid { display:grid; grid-template-columns:1fr 1fr; gap:30px; }
    footer p { margin:5px 0; }
    dialog { width:min(980px,calc(100% - 28px)); border:0; padding:0; background:#101b1c; color:white; box-shadow:0 24px 90px rgba(0,0,0,.45); }
    dialog::backdrop { background:rgba(0,0,0,.75); }
    .close { position:absolute; top:10px; right:10px; z-index:1; width:36px; height:36px; border:0; border-radius:50%; background:white; color:var(--ink); font-size:22px; }
    .button:hover, .button:focus-visible { outline:3px solid #f4c49c; outline-offset:4px; }
    @media (prefers-color-scheme: dark) {
      :root { --ink:#eef3ef; --muted:#d0dbd6; --paper:#182526; --white:#f8f7f2; --line:#526361; --accent:#d39a6a; --accent-dark:#b8784b; --dark:#101719; }
      :root { color-scheme:dark; }
      body { background:var(--paper); color:var(--ink); }
      .site-header { background:rgba(24,37,38,.96); border-color:var(--line); }
      .brand img { filter:invert(1) brightness(1.8); }
      nav a { color:#dce6e1; }
      nav a:hover, nav a:focus-visible { color:#f4c49c; }
      nav a.active { color:#f4c49c; border-color:#f4c49c; }
      .button { background:var(--accent-dark); border-color:var(--accent-dark); }
      .button.secondary { border-color:rgba(255,255,255,.82); }
      .button:hover, .button:focus-visible { background:#8d542f; border-color:#8d542f; }
      .hero { background-image:linear-gradient(90deg,rgba(5,13,14,.92) 0%,rgba(5,13,14,.78) 48%,rgba(5,13,14,.35) 100%),url('img/steve-picks/08/IMG_5346.jpg'); }
      .hero-copy { background:rgba(5,13,14,.46); }
      .eyebrow { color:#f4c49c; }
      .story-card, .contact-card { background:#243536; border-color:var(--line); }
      .story-card p, .section-intro p, .contact-card p { color:var(--muted); }
      .portfolio, .dealers { background:#101719; }
      .project-card, .dealer-logo, .testimonial { background:#314344; }
      .process, .dark-process { background:#202f30; color:var(--ink); }
      .dark-process .step, .step { background:#314344; }
      .dark-process .section-intro p, .dark-process .step p, .step p { color:var(--muted); }
      .dealers-link { background:var(--accent-dark); }
      .dealers-link:hover, .dealers-link:focus-visible { background:#8d542f; }
      #contact { background:#202f30; }
      footer { background:#0b1112; color:#dce6e1; }
      footer a, .contact-card a { color:#f4c49c; }
      dialog { background:#101b1c; }
      .close { background:#f8f7f2; color:#182526; }
    }
    @media (max-width:800px) { .site-header { align-items:flex-start; flex-direction:column; } .story-grid,.gallery,.process-grid,.about-grid,.contact-grid,.dealer-grid,.testimonial-grid { grid-template-columns:1fr; } .hero { min-height:70vh; } .button.secondary { margin:10px 0 0; } footer .footer-grid { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <header class="site-header"><a class="brand" href="#top"><img src="img/logos/artisan.png" alt="Artisan Kitchen and Bath"></a><nav aria-label="Main navigation"><a href="#top" data-nav-home>Home</a><a href="#portfolio" data-nav-section="portfolio">Portfolio</a><a href="#services" data-nav-section="services">Services</a><a href="#about" data-nav-section="about">About</a><a href="#contact" data-nav-section="contact">Contact</a></nav></header>
  <main id="top">
    <section class="hero"><div class="hero-copy"><div class="eyebrow">Custom cabinetry · Cornwall & Prescott, Ontario</div><h1>Spaces made for living beautifully.</h1><p>Personalized kitchens, bathrooms, and millwork designed, built, and installed with care.</p><a class="button" href="#portfolio">Explore the portfolio</a><a class="button secondary" href="contact/">Start a conversation</a></div></section>
    <section id="intro"><div class="section-intro"><div class="eyebrow">The Artisan approach</div><h2>Thoughtful design. Exceptional craft.</h2><p>Artisan Kitchen and Bath delivers bespoke services from initial design to precise production and installation. Every project is shaped around the way you live, with quality and elegance built into every detail.</p></div><div class="story-grid"><article class="story-card"><h3>Personalized</h3><p>We listen closely, measure carefully, and develop a space that reflects your style and priorities.</p></article><article class="story-card"><h3>Built to last</h3><p>Our team oversees the work from design through installation, holding every project to a high standard.</p></article><article class="story-card"><h3>Made local</h3><p>Based in Cornwall and serving the Prescott/Brockville area, we bring a personal, hands-on approach to every home.</p></article></div></section>
    <section class="portfolio" id="portfolio" aria-labelledby="homepage-portfolio-heading"><div class="section-intro"><div class="eyebrow">Selected work</div><h2 id="homepage-portfolio-heading">A glimpse of the work.</h2><p>Explore a sample of our kitchens, bathrooms, and custom millwork, then visit the full Portfolio page for the complete gallery.</p></div><div class="gallery"><figure class="project-card"><img src="img/steve-picks/42/IMG_3547-HDR.jpg" alt="Kitchen with custom cabinetry, stone counters, and a dining area" loading="lazy"><figcaption><strong>Kitchens</strong><span>Custom cabinetry and considered details.</span></figcaption></figure><figure class="project-card"><img src="img/steve-picks/47/Main 1.jpg" alt="Bathroom with a freestanding tub and tiled walk-in shower" loading="lazy"><figcaption><strong>Bathrooms</strong><span>Calm, functional spaces made to last.</span></figcaption></figure><figure class="project-card"><img src="img/steve-picks/06/Artisan-27.jpg" alt="Custom built-in wood bar and cabinetry" loading="lazy"><figcaption><strong>Custom millwork</strong><span>Built-ins that bring character to a room.</span></figcaption></figure></div><p class="text-center"><a class="button" href="portfolio/">View the full portfolio</a></p></section>
    <section class="process dark-process" id="services"><div class="section-intro"><div class="eyebrow">From idea to installation</div><h2>Your project in five steps.</h2><p>Artisan Kitchen and Bath offers personalized service from design, production, and installation.</p></div><div class="process-grid"><article class="step"><i class="fas fa-comments" aria-hidden="true"></i><b>01 · Consultation</b><p>Meet and discuss the project in depth. We come to your home and measure the space.</p></article><article class="step"><i class="fas fa-drafting-compass" aria-hidden="true"></i><b>02 · Design</b><p>Review 3D designs, refine the details, and select materials and colours together.</p></article><article class="step"><i class="fas fa-dollar-sign" aria-hidden="true"></i><b>03 · Price</b><p>Once the design and materials are finalized, we provide an estimate.</p></article><article class="step"><i class="fas fa-cogs" aria-hidden="true"></i><b>04 · Production</b><p>After approval and final measurements, we proceed with ordering and production.</p></article><article class="step"><i class="fas fa-toolbox" aria-hidden="true"></i><b>05 · Installation</b><p>Skilled installers bring the finished project to life in your home.</p></article></div></section>
    <section class="dealers" aria-labelledby="dealers-heading"><div class="section-intro"><div class="eyebrow">Our cabinet dealers</div><h2 id="dealers-heading">Trusted partners in every project.</h2><p>We work with respected cabinet makers to bring lasting quality, thoughtful design, and dependable craftsmanship to every space.</p></div><div class="dealer-grid"><a class="dealer-logo" href="https://www.miralis.com/" target="_blank" rel="noopener noreferrer"><img src="img/logos/miralis_dark.jpg" alt="Miralis"></a><a class="dealer-logo" href="https://elmwoodcabinets.com/project/timeless-elegance/" target="_blank" rel="noopener noreferrer"><img src="img/logos/elmwood.png" alt="Elmwood"></a><a class="dealer-logo" href="https://cabico.com/en/" target="_blank" rel="noopener noreferrer"><img src="img/logos/cabico.png" alt="Cabico"></a></div><a class="dealers-link" href="partners/">See who we partner with</a></section>
    <section class="testimonials" aria-labelledby="testimonials-heading"><div class="section-intro"><div class="eyebrow">Client stories</div><h2 id="testimonials-heading">Made for living. Remembered for the details.</h2><p>Discover the experiences of our clients and the care that goes into every Artisan kitchen, bathroom, and millwork project.</p></div><div class="testimonial-grid">
      <blockquote class="testimonial"><p>Artisan Kitchen and Bath were called in to renovate an old condo from the 60's - new kitchen plan complete with cabinets and many “nice to have” updates. Steve took the same approach in updating the bathrooms with fresh new cabinets and ideas to maximize space while creating the new look.</p><p>He prepared a good plan, presented fresh ideas, finalized a reasonable quote based on known lead times, and executed the plan perfectly. The kitchen arrived on time and the install went very good, especially given the challenges of hanging cabinets on old plaster walls without the usual studs to anchor them to.</p><p>I felt that this contractor was very talented, he communicated well and in a timely fashion, and was very co-operative in providing ideas and information outside his kitchen/bath obligations. And at end of each day, his house keeping was such that there was never any reason to follow behind and re-do the clean up - he was fussy about his work and paid close attention to detail throughout.</p><p>There is no doubt that I would contact Steve through Artisan Kitchen and Bath to help me out with the next project.</p><footer><cite>Dale Golledge</cite><span class="testimonial-rating" aria-label="5 out of 5 stars" role="img">★★★★★</span></footer></blockquote>
      <blockquote class="testimonial"><p>We met with multiple contractors for our kitchen renovation, and then along came Artisan. To say we are happy with our new kitchen would be an understatement. Artisan truly brought my vision to life!</p><p>They are extremely professional, have excellent communication skills, meticulous and organized. They are always willing to trouble shoot and be flexible. We've already had them back for some additional work, and wouldn't hesitate to hire them again! Thanks again Artisan!!</p><footer><cite>Jordan Schaille</cite><span class="testimonial-rating" aria-label="5 out of 5 stars" role="img">★★★★★</span></footer></blockquote>
      <blockquote class="testimonial"><p>Absolutely love my new kitchen, something out of a magazine!! Really enjoyed working with Artisan, they are meticulous, very professional and has great design ideas! This is my 3rd kitchen over the years (different homes) one of the best ones yet! I highly recommend Artisan Kitchen and Bath!!</p><footer><cite>Helen Kostovos</cite><span class="testimonial-rating" aria-label="5 out of 5 stars" role="img">★★★★★</span></footer></blockquote>
      <blockquote class="testimonial"><p>With Artisan Wood Designs you get what you pay for. Fantastic design team, high quality products installed with great care on time as promised. I am very happy with my new Artisan kitchen.</p><footer><cite>Darcy Aitkens</cite><span class="testimonial-rating" aria-label="5 out of 5 stars" role="img">★★★★★</span></footer></blockquote>
      <blockquote class="testimonial"><p>Award winning designers and the finest artists to install the millwork. Flawless craftsmanship!</p><footer><cite>Francois Asselin</cite><span class="testimonial-rating" aria-label="5 out of 5 stars" role="img">★★★★★</span></footer></blockquote>
    </div></section>
    <section id="about"><div class="about-grid"><div><div class="eyebrow">About Artisan</div><h2>Craftsmanship with a personal touch.</h2><p>Artisan Kitchen and Bath, based in Cornwall, Ontario, is a destination for personalized custom cabinetry solutions. With an unwavering commitment to craftsmanship, creativity, and professionalism, the team offers tailored services from design conception to meticulous installation.</p><p>Meet Steve and Manny, whose friendship and shared passion for design and craftsmanship grew from a modest Cornwall workshop into a business known for quality and innovation. They remain at the heart of the operation, overseeing projects and bringing a hands-on approach to every space.</p></div><div class="contact-card"><h3>Two showrooms</h3><p><strong>Cornwall</strong><br>18255 Tyotown Rd<br>South Glengarry, Ontario K6H 7S7<br><a href="tel:6139337272">613-933-7272</a></p><p><strong>Prescott</strong><br>1652 Cty Rd 2<br>Prescott, Ontario K0E 1T0<br><a href="tel:6139252777">613-925-2777</a></p><p>Monday–Friday, 9:00 AM–5:00 PM</p></div></div></section>
    <section id="contact" class="process"><div class="contact-grid"><div><div class="eyebrow">Let’s talk</div><h2>Ready to begin?</h2><p>Whether you are planning a new home or remodeling your present space, we would love to hear what you have in mind.</p><a class="button" href="contact/">Contact Artisan</a></div><div class="contact-card"><h3>Contact Artisan Kitchen and Bath</h3><p>Tell us a little about your project and we will be in touch.</p><p><a href="mailto:info@artisankitchenandbath.ca">info@artisankitchenandbath.ca</a></p><p>Follow along on <a href="https://www.instagram.com/artisankitchenandbath18255/">Instagram</a> and <a href="https://www.facebook.com/ArtisanWoodDesigns">Facebook</a>.</p></div></div></section>
  </main>
  <footer><div class="footer-grid"><div><strong>Artisan Kitchen and Bath</strong><p>Custom kitchens, bathrooms, and millwork.</p></div><div><p>Cornwall · Prescott · Southeastern Ontario</p><p>© {{ settings.currentYear }} Artisan Kitchen and Bath</p></div></div></footer>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    const homeLink = document.querySelector('[data-nav-home]');
    const homeNavLinks = [...document.querySelectorAll('[data-nav-section]')];
    const homeSections = homeNavLinks.map(link => document.getElementById(link.dataset.navSection)).filter(Boolean);
    const setActiveSection = id => homeNavLinks.forEach(link => {
      const active = link.dataset.navSection === id;
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    const updateHomeState = () => {
      const active = window.scrollY < 80;
      homeLink.classList.toggle('active', active);
      if (active) homeLink.setAttribute('aria-current', 'page');
      else homeLink.removeAttribute('aria-current');
      if (active) setActiveSection('');
    };
    const atPageEnd = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8;
    const sectionObserver = new IntersectionObserver(entries => {
      if (atPageEnd()) {
        setActiveSection('contact');
        return;
      }
      const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio);
      if (visible[0]) setActiveSection(visible[0].target.id);
    }, { rootMargin: '-15% 0px -65% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] });
    homeSections.forEach(section => sectionObserver.observe(section));
    window.addEventListener('scroll', () => { updateHomeState(); if (atPageEnd()) setActiveSection('contact'); }, { passive: true });
    updateHomeState();
  </script>
</body>
</html>
