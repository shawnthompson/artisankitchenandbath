<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Custom kitchens, bathrooms, and millwork from Artisan Kitchen and Bath in Cornwall and Prescott, Ontario.">
  <title>Artisan Kitchen and Bath | Custom Kitchens, Baths & Millwork</title>
  <style>
    :root { --ink:#1c2a2b; --muted:#617071; --paper:#f7f6f1; --white:#fff; --line:#d9dfdb; --accent:#a06a43; --accent-dark:#70452b; --dark:#243536; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; background:var(--paper); color:var(--ink); font:16px/1.6 Georgia,serif; }
    a { color:inherit; }
    .site-header { position:sticky; top:0; z-index:5; display:flex; justify-content:space-between; align-items:center; gap:24px; padding:16px clamp(20px,5vw,72px); background:rgba(247,246,241,.96); border-bottom:1px solid var(--line); backdrop-filter:blur(10px); }
    .brand { text-decoration:none; font:700 19px/1.1 Arial,sans-serif; letter-spacing:.03em; text-transform:uppercase; }
    nav { display:flex; flex-wrap:wrap; gap:18px; font:600 13px Arial,sans-serif; text-transform:uppercase; letter-spacing:.08em; }
    nav a { text-decoration:none; color:var(--muted); }
    nav a:hover, nav a:focus-visible { color:var(--accent-dark); }
    .hero { min-height:78vh; display:grid; place-items:end start; padding:clamp(36px,7vw,92px); background:linear-gradient(90deg,rgba(17,30,30,.72),rgba(17,30,30,.08)),url('img/steve-picks/08/IMG_5346.jpg') center/cover; color:var(--white); }
    .hero-copy { max-width:680px; }
    .eyebrow { font:700 12px Arial,sans-serif; letter-spacing:.16em; text-transform:uppercase; color:#ecd5be; }
    h1,h2,h3 { line-height:1.1; margin:0 0 18px; }
    h1 { font-size:clamp(42px,7vw,88px); max-width:760px; }
    h2 { font-size:clamp(32px,4vw,56px); }
    h3 { font-size:24px; }
    .hero p { max-width:590px; font-size:clamp(18px,2vw,24px); }
    .button { display:inline-block; padding:12px 18px; border:1px solid var(--accent); background:var(--accent); color:white; text-decoration:none; font:700 13px Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .button.secondary { background:transparent; border-color:rgba(255,255,255,.7); margin-left:8px; }
    section { padding:clamp(56px,8vw,112px) clamp(20px,6vw,88px); }
    .section-intro { max-width:740px; margin-bottom:34px; }
    .section-intro p { color:var(--muted); font-size:19px; }
    .story-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
    .story-card { padding:26px; background:var(--white); border:1px solid var(--line); }
    .story-card p { color:var(--muted); margin-bottom:0; }
    .portfolio { background:var(--dark); color:var(--white); }
    .portfolio .section-intro p { color:#cbd6d2; }
    .filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:24px; }
    .filters button { border:1px solid #627777; border-radius:999px; padding:9px 14px; background:transparent; color:white; font:700 12px Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .filters button[aria-pressed="true"], .filters button:hover, .filters button:focus-visible { background:var(--accent); border-color:var(--accent); }
    .gallery { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .project-card { margin:0; background:#314344; overflow:hidden; }
    .project-card button { display:block; width:100%; padding:0; border:0; background:none; color:inherit; text-align:left; cursor:pointer; }
    .project-card img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; transition:transform .25s; }
    .project-card button:hover img, .project-card button:focus-visible img { transform:scale(1.03); }
    .project-card figcaption { padding:13px 15px 16px; }
    .project-card strong { display:block; font:700 16px Arial,sans-serif; }
    .project-card span { color:#cbd6d2; font-size:14px; }
    .process { background:#eeeae0; }
    .process-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; }
    .step { padding:22px 16px; border-top:3px solid var(--accent); background:rgba(255,255,255,.55); }
    .step b { display:block; color:var(--accent-dark); font:700 12px Arial,sans-serif; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; }
    .step p { margin:0; color:var(--muted); }
    .about-grid, .contact-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:50px; align-items:start; }
    .contact-card { padding:28px; background:white; border:1px solid var(--line); }
    .contact-card p { margin:8px 0; }
    .contact-card a { color:var(--accent-dark); }
    footer { padding:36px clamp(20px,6vw,88px); background:#182526; color:#d7e0dc; }
    footer .footer-grid { display:grid; grid-template-columns:1fr 1fr; gap:30px; }
    footer p { margin:5px 0; }
    dialog { width:min(980px,calc(100% - 28px)); border:0; padding:0; background:#101b1c; color:white; box-shadow:0 24px 90px rgba(0,0,0,.45); }
    dialog::backdrop { background:rgba(0,0,0,.75); }
    .lightbox { position:relative; display:grid; grid-template-columns:1fr 260px; }
    .lightbox img { display:block; width:100%; max-height:82vh; object-fit:contain; background:#0b1112; }
    .lightbox-info { padding:24px; }
    .lightbox-info p { color:#cbd6d2; }
    .close { position:absolute; top:10px; right:10px; z-index:1; width:36px; height:36px; border:0; border-radius:50%; background:white; color:var(--ink); font-size:22px; }
    :focus-visible { outline:3px solid #e1a777; outline-offset:3px; }
    @media (max-width:800px) { .site-header { align-items:flex-start; flex-direction:column; } .story-grid,.gallery,.process-grid,.about-grid,.contact-grid,.lightbox { grid-template-columns:1fr; } .hero { min-height:70vh; } .button.secondary { margin:10px 0 0; } footer .footer-grid { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <header class="site-header"><a class="brand" href="#top">Artisan Kitchen & Bath</a><nav aria-label="Main navigation"><a href="#portfolio">Portfolio</a><a href="#services">Services</a><a href="#about">About</a><a href="#contact">Contact</a></nav></header>
  <main id="top">
    <section class="hero"><div class="hero-copy"><div class="eyebrow">Custom cabinetry · Cornwall & Prescott, Ontario</div><h1>Spaces made for living beautifully.</h1><p>Personalized kitchens, bathrooms, and millwork designed, built, and installed with care.</p><a class="button" href="#portfolio">Explore the portfolio</a><a class="button secondary" href="#contact">Start a conversation</a></div></section>
    <section id="intro"><div class="section-intro"><div class="eyebrow">The Artisan approach</div><h2>Thoughtful design. Exceptional craft.</h2><p>Artisan Kitchen and Bath delivers bespoke services from initial design to precise production and installation. Every project is shaped around the way you live, with quality and elegance built into every detail.</p></div><div class="story-grid"><article class="story-card"><h3>Personalized</h3><p>We listen closely, measure carefully, and develop a space that reflects your style and priorities.</p></article><article class="story-card"><h3>Built to last</h3><p>Our team oversees the work from design through installation, holding every project to a high standard.</p></article><article class="story-card"><h3>Made local</h3><p>Based in Cornwall and serving the Prescott/Brockville area, we bring a personal, hands-on approach to every home.</p></article></div></section>
    <section class="portfolio" id="portfolio"><div class="section-intro"><div class="eyebrow">Selected work</div><h2>Steve's portfolio</h2><p>A selection of kitchens, bathrooms, and custom millwork supplied for the Artisan website.</p></div><div class="filters" aria-label="Portfolio filters"><button type="button" data-filter="All" aria-pressed="true">All work</button><button type="button" data-filter="Kitchens" aria-pressed="false">Kitchens</button><button type="button" data-filter="Bathrooms" aria-pressed="false">Bathrooms</button><button type="button" data-filter="Custom Millwork" aria-pressed="false">Custom millwork</button></div><div class="gallery" id="gallery"></div></section>
    <section class="process" id="services"><div class="section-intro"><div class="eyebrow">From idea to installation</div><h2>Your project in five steps.</h2><p>Artisan Kitchen and Bath offers personalized service from design, production, and installation.</p></div><div class="process-grid"><article class="step"><b>01 · Consultation</b><p>Meet and discuss the project in depth. We come to your home and measure the space.</p></article><article class="step"><b>02 · Design</b><p>Review 3D designs, refine the details, and select materials and colours together.</p></article><article class="step"><b>03 · Price</b><p>Once the design and materials are finalized, we provide an estimate.</p></article><article class="step"><b>04 · Production</b><p>After approval and final measurements, we proceed with ordering and production.</p></article><article class="step"><b>05 · Installation</b><p>Skilled installers bring the finished project to life in your home.</p></article></div></section>
    <section id="about"><div class="about-grid"><div><div class="eyebrow">About Artisan</div><h2>Craftsmanship with a personal touch.</h2><p>Artisan Kitchen and Bath, based in Cornwall, Ontario, is a destination for personalized custom cabinetry solutions. With an unwavering commitment to craftsmanship, creativity, and professionalism, the team offers tailored services from design conception to meticulous installation.</p><p>Meet Steve and Manny, whose friendship and shared passion for design and craftsmanship grew from a modest Cornwall workshop into a business known for quality and innovation. They remain at the heart of the operation, overseeing projects and bringing a hands-on approach to every space.</p></div><div class="contact-card"><h3>Two showrooms</h3><p><strong>Cornwall</strong><br>18255 Tyotown Rd<br>South Glengarry, Ontario K6H 7S7<br><a href="tel:6139337272">613-933-7272</a></p><p><strong>Prescott</strong><br>1652 Cty Rd 2<br>Prescott, Ontario K0E 1T0<br><a href="tel:6139252777">613-925-2777</a></p><p>Monday–Friday, 9:00 AM–5:00 PM</p></div></div></section>
    <section id="contact" class="process"><div class="contact-grid"><div><div class="eyebrow">Let’s talk</div><h2>Ready to begin?</h2><p>Whether you are planning a new home or remodeling your present space, we would love to hear what you have in mind.</p><a class="button" href="mailto:info@artisankitchenandbath.ca?subject=Project%20inquiry">Email Artisan</a></div><div class="contact-card"><h3>Contact Artisan Kitchen and Bath</h3><p>Tell us a little about your project and we will be in touch.</p><p><a href="mailto:info@artisankitchenandbath.ca">info@artisankitchenandbath.ca</a></p><p>Follow along on <a href="https://www.instagram.com/artisankitchenandbath18255/">Instagram</a> and <a href="https://www.facebook.com/ArtisanWoodDesigns">Facebook</a>.</p></div></div></section>
  </main>
  <footer><div class="footer-grid"><div><strong>Artisan Kitchen and Bath</strong><p>Custom kitchens, bathrooms, and millwork.</p></div><div><p>Cornwall · Prescott · Southeastern Ontario</p><p>© 2025 Artisan Kitchen and Bath</p></div></div></footer>
  <dialog id="lightbox"><button class="close" id="closeLightbox" aria-label="Close project image">×</button><div class="lightbox"><img id="lightboxImage" alt=""><div class="lightbox-info"><div class="eyebrow">Artisan project</div><h2 id="lightboxTitle"></h2><p id="lightboxProject"></p><p id="lightboxCopy"></p></div></div></dialog>
  <script src="site-data.js"></script>
  <script>
    const picks = window.stevePicks || [], gallery = document.getElementById('gallery'), lightbox = document.getElementById('lightbox');
    const copyFor = row => row.category === 'Kitchens' ? 'A considered kitchen designed around daily life, with custom cabinetry, purposeful storage, and a strong material palette.' : row.category === 'Bathrooms' ? 'A calm, highly functional bathroom where custom cabinetry and carefully selected finishes do the work.' : 'Custom millwork that brings architecture, storage, and character together in one finished space.';
    function imagePath(row) { return `assets/${row.assetDir}/${encodeURIComponent(row.image)}`; }
    function render(filter='All') { gallery.replaceChildren(); picks.filter(row=>filter==='All'||row.category===filter).forEach(row=>{ const figure=document.createElement('figure'); figure.className='project-card'; const button=document.createElement('button'); button.type='button'; button.setAttribute('aria-label',`Open ${row.filename}`); const img=document.createElement('img'); img.src=imagePath(row); img.alt=`${row.category} project, ${row.filename}`; img.loading='lazy'; const caption=document.createElement('figcaption'); const strong=document.createElement('strong'); strong.textContent=row.project; const span=document.createElement('span'); span.textContent=row.category; caption.append(strong,span); button.append(img,caption); button.onclick=()=>openLightbox(row); figure.append(button); gallery.append(figure); }); }
    function openLightbox(row) { document.getElementById('lightboxImage').src=imagePath(row); document.getElementById('lightboxImage').alt=`${row.category} project, ${row.filename}`; document.getElementById('lightboxTitle').textContent=row.project; document.getElementById('lightboxProject').textContent=`${row.category} · ${row.filename}`; document.getElementById('lightboxCopy').textContent=copyFor(row); lightbox.showModal(); }
    document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));render(button.dataset.filter);}));
    document.getElementById('closeLightbox').onclick=()=>lightbox.close(); lightbox.addEventListener('click',event=>{if(event.target===lightbox)lightbox.close();}); document.addEventListener('keydown',event=>{if(event.key==='Escape'&&lightbox.open)lightbox.close();}); render();
  </script>
</body>
</html>
