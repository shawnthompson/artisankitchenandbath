<nav class="site-navigation" aria-label="Main navigation">
	<a class="site-brand" href="{{ settings.baseUrl }}">
		<img src="{{ settings.baseUrl }}img/logos/artisan.png" alt="Artisan Kitchen and Bath">
	</a>
	<div class="site-navigation-links">
		<a href="{{ settings.baseUrl }}">Home</a>
		{% for item in ["portfolio", "services", "about", "contact"] %}
		{% if label == item %}
		<span class="site-navigation-current" aria-current="page" aria-disabled="true">
			{{ item | capitalize }}
		</span>
		{% else %}
		<a
			href="{{ settings.baseUrl }}#{{ item }}"
			>
			{{ item | capitalize }}
		</a>
		{% endif %}
		{% endfor %}
	</div>
</nav>
