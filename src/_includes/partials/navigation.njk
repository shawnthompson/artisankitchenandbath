<nav class="site-navigation" aria-label="Main navigation">
	<a class="site-brand" href="{{ settings.baseUrl }}">
		<img src="{{ settings.baseUrl }}img/logos/artisan.png" alt="Artisan Kitchen and Bath">
	</a>
	<div class="site-navigation-links">
		{% for item in ["portfolio", "partners", "services", "about", "contact"] %}
		<a
			class="{% if label == item %}active{% endif %}"
			href="{% if item == 'partners' %}{{ settings.baseUrl }}partners/{% else %}{{ settings.baseUrl }}#{{ item }}{% endif %}"
			{% if label == item %}aria-current="page"{% endif %}>
			{{ item | capitalize }}{% if item == "about" %} Us{% elif item == "contact" %} Us{% endif %}
		</a>
		{% endfor %}
	</div>
</nav>
